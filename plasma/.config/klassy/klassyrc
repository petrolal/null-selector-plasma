[Animations]
AnimationsEnabled=true
ButtonAnimationsEnabled=true

[Borders]
BorderThickness=1
DrawWindowOutline=true
OutlineColorMode=AccentColor
OutlineWidth=1
RoundBottomCorners=true
RoundTopCorners=true
WindowCornerRadius=10

[ButtonColors]
ActiveCloseButtonColor=243,139,168
ActiveMaximizeButtonColor=166,227,161
ActiveMinimizeButtonColor=250,179,135

[ButtonSizing]
ButtonIconScale=100
ButtonMargin=4
ButtonSpacing=6
CloseButtonLeftMargin=0
CloseButtonRightMargin=4

[Decoration]
BlurBehindTitlebar=true
ColorizeTitlebarWithAccent=false
DrawTitlebarBorder=true
DrawWindowShadow=true
OpaqueTitlebar=false
ShadowSize=ShadowMedium
TitlebarOpacity=88

[Fonts]
TitleAlignment=Center
TitleFont=Inter,10,-1,5,70,0,0,0,0,0,Bold

[Global]
LookAndFeelSet=org.kde.breezedark.desktop

[Metrics]
TitlebarBottomMargin=2
TitlebarHeight=28
TitlebarSideMargin=8
TitlebarTopMargin=2

[WindowRules]
DrawBorderOnMaximized=false
RoundCornersOnMaximized=false
