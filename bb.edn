{:paths ["src" "test"]
 :tasks
 {:init (require '[mono-rice.core :as core])
  tui {:doc "Launch interactive Cyberpunk terminal dashboard menu"
       :task (apply core/-main "tui" *command-line-args*)}
  install {:doc "Deploy and install complete null-sector-plasma rice"
           :task (apply core/-main "install" *command-line-args*)}
  harvest {:doc "Scrape live $HOME configs back into repository with template sanitization"
           :task (apply core/-main "harvest" *command-line-args*)}
  backup {:doc "Create a timestamped backup snapshot of current configurations"
          :task (apply core/-main "backup" *command-line-args*)}
  rollback {:doc "List and restore rollback snapshots (bb rollback list | bb rollback restore <name>)"
            :task (apply core/-main "rollback" *command-line-args*)}
  diff {:doc "Inspect visual differences between repo templates and live $HOME configurations"
        :task (apply core/-main "diff" *command-line-args*)}
  verify {:doc "Verify configuration drift and required rice components against rice.edn"
          :task (apply core/-main "verify" *command-line-args*)}
  theme {:doc "List or switch active theme profile (bb theme list | bb theme set <name>)"
         :task (apply core/-main "theme" *command-line-args*)}
  wallpaper {:doc "Manage and sync desktop and lockscreen 4K video wallpapers"
             :task (apply core/-main "wallpaper" *command-line-args*)}
  audio {:doc "Configure and switch CAVA / Kurve audio equalizer presets"
         :task (apply core/-main "audio" *command-line-args*)}
  watch {:doc "Monitor configuration drift against repository templates"
         :task (apply core/-main "watch" *command-line-args*)}
  daemon {:doc "Background sentinel service and desktop notification manager"
          :task (apply core/-main "daemon" *command-line-args*)}
  bundle {:doc "Export or import portable rice bundles (bb bundle export | bb bundle import <file>)"
          :task (apply core/-main "bundle" *command-line-args*)}
  plasmoid {:doc "Manage KDE 6 desktop plasmoids (bb plasmoid list | bb plasmoid install <path>)"
            :task (apply core/-main "plasmoid" *command-line-args*)}
  dump-widgets {:doc "Pretty-print active containment/plasmoid tree"
                :task (apply core/-main "dump-widgets" *command-line-args*)}
  open-zen-mods {:doc "Open Zen Browser mod install pages"
                 :task (apply core/-main "open-zen-mods" *command-line-args*)}
  test {:doc "Run test suite across all engine modules"
        :task (do
                (require 'mono-rice.sanitizer-test
                         'mono-rice.manifest-test
                         'mono-rice.inspector-test
                         'mono-rice.theme-test
                         'mono-rice.scaling-test
                         'mono-rice.watch-test
                         'mono-rice.rollback-test
                         'mono-rice.diff-test
                         'mono-rice.bundle-test
                         'mono-rice.plasmoid-test
                         'mono-rice.tui-test
                         'mono-rice.daemon-test
                         'mono-rice.wallpaper-test
                         'mono-rice.audio-test
                         'clojure.test)
                (let [{:keys [fail error]} (clojure.test/run-tests 'mono-rice.sanitizer-test
                                                                   'mono-rice.manifest-test
                                                                   'mono-rice.inspector-test
                                                                   'mono-rice.theme-test
                                                                   'mono-rice.scaling-test
                                                                   'mono-rice.watch-test
                                                                   'mono-rice.rollback-test
                                                                   'mono-rice.diff-test
                                                                   'mono-rice.bundle-test
                                                                   'mono-rice.plasmoid-test
                                                                   'mono-rice.tui-test
                                                                   'mono-rice.daemon-test
                                                                   'mono-rice.wallpaper-test
                                                                   'mono-rice.audio-test)]
                  (when (or (pos? fail) (pos? error))
                    (System/exit 1))))}
  check {:doc "Run dry-run verification check on all core flows"
         :task (do
                 (println "==> Running dry-run validation checks...")
                 (core/-main "tui" "--dry-run")
                 (core/-main "verify")
                 (core/-main "backup" "--dry-run")
                 (core/-main "theme" "list")
                 (core/-main "wallpaper" "list")
                 (core/-main "audio" "list")
                 (core/-main "watch" "--once")
                 (core/-main "rollback" "list")
                 (core/-main "diff")
                 (core/-main "bundle" "export" "/tmp/test-check-bundle.tar.gz" "--dry-run")
                 (println "==> All checks passed successfully!"))}
  repl {:doc "Start an interactive Babashka REPL server"
        :override-builtin true
        :task (do
                (println "Starting Babashka nREPL server on port 1667...")
                (babashka.nrepl.server/start-server! {:port 1667}))}}}
