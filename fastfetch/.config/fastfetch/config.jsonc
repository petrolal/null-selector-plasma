{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/null_sector.txt",
    "color": {
      "1": "white",
      "2": "bright_black"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },

  "display": {
    "separator": "  󰄾  "
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "───────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "31"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "90"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "90"
    },
    {
      "type": "uptime",
      "key": "󰔚 Uptime",
      "keyColor": "90"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "90"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "31"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "90"
    },
    {
      "type": "de",
      "key": "󰧨 DE",
      "keyColor": "31"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "90"
    },
    {
      "type": "theme",
      "key": "󰉼 Theme",
      "keyColor": "90"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons",
      "keyColor": "90"
    },
    {
      "type": "font",
      "key": "󰛖 Font",
      "keyColor": "90"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal",
      "keyColor": "31"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "90"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "90"
    },
    {
      "type": "memory",
      "key": "󰑭 Memory",
      "keyColor": "90"
    },
    "break",
    "colors"
  ]
}

