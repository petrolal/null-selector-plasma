[general]
framerate = 60
bars = 48
bar_width = 2
bar_spacing = 3

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 32

[smoothing]
integral = 75
monstercat = 1
waves = 0
gravity = 100
