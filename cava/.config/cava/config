[general]
framerate = 60
bars = 48
bar_width = 2
bar_spacing = 3

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 32

[color]
gradient = 1
gradient_count = 2
gradient_color_1 = '#660000'
gradient_color_2 = '#e0e0e0'

[smoothing]
integral = 85
monstercat = 1
waves = 0
gravity = 110
noise_reduction = 0.77

